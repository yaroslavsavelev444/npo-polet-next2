{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"], // главный алиас – корень проекта
      "@/payload-types": ["./payload-types.ts"],
      "@/payloadconfig": ["./payload.config.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",

    // Браузерный набор проверяется НЕ этим проектом.
    //
    // Playwright и его типы живут в tests/e2e/.runner/node_modules — отдельном
    // дереве зависимостей, которое ставится командой `pnpm e2e:install` и в
    // основной lock-файл намеренно не входит (см. .gitignore): иначе браузерный
    // раннер пришлось бы разворачивать на каждой машине и в каждом job'е CI,
    // включая те, которым он не нужен.
    //
    // Пока эти файлы не были в git, расхождение никто не замечал. Как только
    // они попали в репозиторий, `tsc --noEmit` начал их проверять — без типов
    // @playwright/test, то есть с гарантированным результатом: TS2307 на
    // импорте и каскад TS7031/TS7006, потому что при `strict` каждый
    // невыведенный `page`/`request`/`route` становится неявным any.
    //
    // Типы спеков проверяет сам Playwright при прогоне (tests/e2e/
    // playwright.config.ts), уже имея свои зависимости на месте.
    "tests/e2e"
  ]
}
