# Пример файла окружения для бэкапов PostgreSQL.
#
# Скопируйте в scripts/backup/backup.env и при необходимости переопределите.
# Файл НЕ коммитится (.env* в .gitignore) и не содержит секретов —
# пароль БД читается напрямую из .env.production.
#
# Скопировать:  cp scripts/backup/backup.env.example scripts/backup/backup.env

# Корень проекта на сервере.
# PROJECT_DIR="/home/y4s/polet-next"

# Файл с секретами (берётся POSTGRES_PASSWORD).
# ENV_FILE="/home/y4s/polet-next/.env.production"

# Имя контейнера Postgres.
# PG_CONTAINER="polet-next-postgres-prod"

# Параметры базы.
# PG_DB="npo_polet"
# PG_USER="npo_user"

# Куда складывать бэкапы (вне git-дерева).
# BACKUP_DIR="/var/backups/polet-postgres"

# Сколько последних успешных бэкапов хранить (недельная история).
# BACKUP_KEEP="7"

# Минимальный размер валидного дампа в байтах.
# BACKUP_MIN_BYTES="1000"

# Каталог/файл логов.
# BACKUP_LOG_DIR="/home/y4s/polet-next/logs"
# BACKUP_LOG_FILE="/home/y4s/polet-next/logs/backup.log"
