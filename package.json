{
	"name": "polet-next",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@11.8.0",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome check .",
		"payload": "payload",
		"payload:verify-graph": "tsx scripts/verify-payload-graph.mjs",
		"payload:types": "node --experimental-strip-types scripts/payload-cli.mts generate:types",
		"payload:importmap": "node --experimental-strip-types scripts/payload-cli.mts generate:importmap",
		"payload:sync": "pnpm payload:types && pnpm payload:importmap",
		"worker:account-deletion": "tsx src/modules/account-deletion/worker.ts",
		"migrate:legacy": "node --experimental-strip-types scripts/db-migrate/run.ts",
		"slugs:backfill": "node --experimental-strip-types scripts/backfill-product-slugs.ts",
		"slug:regenerate": "node --experimental-strip-types scripts/regenerate-product-slug.ts",
		"type-check": "tsc --noEmit",
		"test:security": "node --experimental-strip-types --test tests/security/*.test.ts",
		"test:checkout": "node --experimental-strip-types --test tests/checkout/*.test.ts",
		"test:promo": "node --experimental-strip-types --test tests/promo/*.test.ts",
		"test": "node --experimental-strip-types --test tests/security/*.test.ts tests/checkout/*.test.ts tests/promo/*.test.ts",
		"seed:e2e": "node --experimental-strip-types scripts/seed-checkout-e2e.ts",
		"reset:e2e-cart": "node --experimental-strip-types scripts/reset-e2e-cart.ts",
		"test:e2e": "tests/e2e/.runner/node_modules/.bin/playwright test --config tests/e2e/playwright.config.ts",
		"test:e2e:ui": "tests/e2e/.runner/node_modules/.bin/playwright test --config tests/e2e/playwright.config.ts --ui",
		"e2e:install": "npm --prefix tests/e2e/.runner install && tests/e2e/.runner/node_modules/.bin/playwright install chromium",
		"payload:migrate": "node --experimental-strip-types scripts/payload-cli.mts migrate",
		"payload:migrate:create": "node --experimental-strip-types scripts/payload-cli.mts migrate:create",
		"payload:migrate:status": "node --experimental-strip-types scripts/payload-cli.mts migrate:status"
	},
	"dependencies": {
		"@hookform/resolvers": "^5.4.0",
		"@once-ui-system/core": "^1.7.10",
		"@payloadcms/db-postgres": "^3.85.1",
		"@payloadcms/next": "^3.85.1",
		"@payloadcms/richtext-lexical": "^3.85.1",
		"@payloadcms/translations": "^3.85.1",
		"@payloadcms/ui": "^3.85.1",
		"@tanstack/react-query": "^5.101.0",
		"@tanstack/react-query-devtools": "^5.101.0",
		"bcryptjs": "^3.0.3",
		"bullmq": "^5.79.0",
		"clsx": "^2.1.1",
		"dotenv": "^17.4.2",
		"ioredis": "^5.11.1",
		"lodash": "^4.18.1",
		"lucide-react": "^1.21.0",
		"mongodb": "^7.5.0",
		"next": "16.2.11",
		"nodemailer": "^9.0.3",
		"payload": "^3.85.1",
		"qrcode": "^1.5.4",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"react-hook-form": "^7.80.0",
		"react-intersection-observer": "^10.0.3",
		"react-remove-scroll": "^2.7.2",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"transliteration": "^2.6.1",
		"xss": "^1.0.15",
		"zod": "^4.4.3",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.2",
		"@tailwindcss/postcss": "^4",
		"@types/lodash": "^4.17.24",
		"@types/node": "^20",
		"@types/nodemailer": "^8.0.1",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9",
		"eslint-config-next": "16.2.11",
		"tailwindcss": "^4",
		"tsx": "4.22.4",
		"typescript": "^5"
	}
}
