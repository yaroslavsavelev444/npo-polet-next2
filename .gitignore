# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
db/
# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# E2E (Playwright)
# Раннер живёт отдельно от node_modules проекта: CI ставит зависимости с
# --frozen-lockfile, и браузерный раннер в основном lock-файле заставлял бы
# пересобирать всё дерево на каждой машине. Установка: pnpm e2e:install.
/tests/e2e/.runner/node_modules
/tests/e2e/node_modules
/tests/e2e/.auth
/tests/e2e/.output
/tests/e2e/.report
