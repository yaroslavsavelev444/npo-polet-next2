# Что НЕ уезжает в контекст сборки.
#
# Файла до сих пор не было, и это стоило дорого: `node_modules` с macOS и
# каталог `.next` с локальной сборки ехали в контекст на каждой сборке. Они
# не только замедляют передачу — они ломают кеш слоёв (контекст меняется от
# любого локального `pnpm dev`) и способны попасть в образ поверх того, что в
# нём собрано, вместе с бинарниками, собранными не под Linux.

node_modules
**/node_modules
.next
out
build

.git
.github
.claude
.vscode

# Медиа и база разработки: чужие файлы, которым в образе делать нечего.
# В проде медиа живут в томе polet-next_media_data, а не в контексте сборки.
media
db
logs

# Артефакты тестов.
#
# Весь tests/e2e целиком, а не только его node_modules: раннер Playwright
# живёт со СВОИМИ зависимостями (tests/e2e/.runner/node_modules), в дерево
# проекта они не ставятся, и `next build` внутри образа спотыкался на
# `Cannot find module '@playwright/test'` при проверке типов. В CI этой
# ошибки не видно только потому, что каталог сейчас вообще не в git, —
# то есть локальная сборка расходилась бы с CI молча.
tests/e2e
test-results
coverage

# Секреты. Ни один .env не должен попасть в контекст: значения сборки
# приходят через build-args (несекретные) — см. Dockerfile.
.env
.env.*

# Мусор рабочей машины
.DS_Store
*.log
*.tsbuildinfo

# Конфигурация серверов: разворачивается на VPS из bundle'а, не из образа.
nginx*.txt
nginx*.conf
proxy_params_npo*.conf
Caddyfile
